// Leo District Council 325 K — Phase 1 schema (starter). MySQL / MariaDB on cPanel.
// Check the server's OpenSSL version (`openssl version` in cPanel Terminal) and keep the matching binary target.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // local `prisma migrate dev` only
}

// MariaDB 10.4 (XAMPP) compatible: no Json columns; JSON is stored as text and validated with Zod.

// ───────────── Admin users & security ─────────────

enum Role {
  ADMIN
  EDITOR
}

// Accounts are created with `npm run user:create` (never seeded). Username: trimmed, lowercase,
// [a-z0-9._-]{3,32} (src/lib/auth/password.mjs). Email stays empty until Sprint 6.
model User {
  id                 String          @id @default(cuid())
  username           String          @unique @db.VarChar(32)
  displayName        String
  email              String?         @unique
  role               Role            @default(EDITOR)
  passwordHash       String
  active             Boolean         @default(true)
  // Set when an Admin creates the account or resets its password: the user must choose their own
  // password before any other admin screen opens (Sprint 5a).
  mustChangePassword Boolean         @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sessions           Session[]
  trustedDevices     TrustedDevice[]
  loginCodes         LoginCode[]
  activities         ActivityLog[]
}

// Only the SHA-256 hash of the cookie token is stored. Idle timeout counts from lastSeenAt;
// expiresAt is the absolute end (src/lib/auth/session-rules.ts).
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ipHash     String?
  userAgent  String?  @db.VarChar(255)

  @@index([userId])
}

model TrustedDevice {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum CodePurpose {
  NEW_DEVICE
  PASSWORD_RESET
  INVITE
}

model LoginCode {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, purpose])
}

// Login throttle (src/lib/auth/throttle.ts). Keys are HMACs of the username and/or IP, never the
// plain values: "u:…" (backoff via nextAllowedAt, never locked), "ip:…" and "uip:…" (lockedUntil).
model LoginThrottle {
  key           String    @id @db.VarChar(80)
  failures      Int       @default(0)
  lastFailureAt DateTime
  nextAllowedAt DateTime?
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([updatedAt])
}

model RateLimit {
  key     String   @id // e.g. "login:<emailHash>:<ipHash>"
  count   Int      @default(0)
  resetAt DateTime
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "person.create", "leoYear.publish"
  entity    String?
  entityId  String?
  summary   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Leadership ─────────────

model LeoYear {
  id          String     @id @default(cuid())
  label       String     @unique // "2026–27"
  startsOn    DateTime   @db.Date // 1 July
  endsOn      DateTime   @db.Date // 30 June
  isCurrent   Boolean    @default(false)
  published   Boolean    @default(false)
  publishedAt DateTime?
  positions   Position[]
  theme       ThemeSet?
}

// Visibility (docs/07): each *Public switch is null = follow PUBLIC_BY_DEFAULT (src/lib/visibility.ts),
// true/false = set for this person. under18 hides membership no., cell, landline, email and blood
// group with no override. address is admin-only and never read by a public query.
model Person {
  id                String        @id @default(cuid())
  title             String        @db.VarChar(20) // PERSON_TITLES in src/lib/people.ts
  fullName          String
  photo             String? // file name under UPLOAD_DIR/people
  photoConsent      Boolean       @default(false) // photo is public only when ticked
  under18           Boolean       @default(false)
  homeClubId        String?
  homeClub          Club?         @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  membershipId      String? // membership no.
  phone             String? // cell
  landline          String?       @db.VarChar(30)
  email             String?
  bloodGroup        String?       @db.VarChar(3) // BLOOD_GROUPS in src/lib/people.ts
  address           String?       @db.VarChar(300) // ADMIN ONLY
  designationPublic Boolean?
  homeClubPublic    Boolean?
  membershipPublic  Boolean?
  phonePublic       Boolean?
  landlinePublic    Boolean?
  emailPublic       Boolean?
  bloodGroupPublic  Boolean?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  positions         Position[]
  awards            Award[]
  journey           JourneyStep[]
  pride             PrideEntry[]

  @@index([fullName])
}

// Leadership page sections. To add a group: a new value here + its label in src/lib/leadership-groups.ts.
enum PositionGroup {
  DISTRICT_BOARD
  DISTRICT_ADVISORS
  DISTRICT_PRESIDENT_ADVISORS
  CLUB // club boards (Sprint 5b)
}

// Editors save drafts; only Admins publish. Public = PUBLISHED and the Leo Year is published.
enum PositionStatus {
  DRAFT
  PUBLISHED
}

model Position {
  id        String         @id @default(cuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  leoYearId String
  leoYear   LeoYear        @relation(fields: [leoYearId], references: [id], onDelete: Cascade)
  group     PositionGroup
  role      String // designation: "District President", "Advisor"...
  clubId    String? // required when group = CLUB
  club      Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  message   String?        @db.Text // District President's message for the year
  sortOrder Int            @default(0)
  status    PositionStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // No unique key: advisors may share a designation. The editor blocks the same person holding the
  // same designation twice in one year and group.
  @@index([leoYearId, group, sortOrder])
  @@index([personId])
}

model Award {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  title    String
  year     String // "2024/25"
  sort     Int    @default(0)
}

model JourneyStep {
  id           String @id @default(cuid())
  personId     String
  person       Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  year         String
  role         String
  organisation String
  sort         Int    @default(0)
}

model PrideEntry {
  id         String  @id @default(cuid())
  personId   String
  person     Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  honorTitle String // "DP 325 K 2022–23"
  note       String? @db.Text
  sort       Int     @default(0)
}

// ───────────── Clubs ─────────────

model Region {
  id    String @id @default(cuid())
  name  String @unique
  sort  Int    @default(0)
  clubs Club[]
}

enum ClubType {
  ALPHA
  OMEGA
}

model Club {
  id                String     @id @default(cuid())
  name              String     @unique
  slug              String     @unique
  regionId          String?
  region            Region?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  city              String? // empty only for unlisted clubs added by name as a home club
  type              ClubType?
  charterYear       Int?
  sponsor           String? // sponsoring Lions club
  email             String?
  logo              String?
  // false: selectable as a home club (older or other clubs), never on the Clubs page
  listedInDirectory Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  positions         Position[]
  members           Person[]   @relation("HomeClub")
  messages          Message[]
}

// ───────────── Resources ─────────────

enum ResourceKind {
  FILE
  LINK
}

model ResourceCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sort      Int        @default(0)
  resources Resource[]
}

model Resource {
  id            String           @id @default(cuid())
  title         String
  description   String           @db.VarChar(500)
  categoryId    String
  category      ResourceCategory @relation(fields: [categoryId], references: [id])
  kind          ResourceKind
  filePath      String?
  fileType      String? // PDF, DOCX, ZIP
  fileSize      Int?
  url           String?
  featured      Boolean          @default(false)
  featuredOrder Int? // order of the "Essentials for every club" cards (featured = true, ascending)
  published     Boolean          @default(false) // only published rows appear publicly
  sort          Int              @default(0)
  updatedAt     DateTime         @updatedAt
  createdAt     DateTime         @default(now())
}

// ───────────── Site content & theme ─────────────

model SiteSetting {
  key       String   @id // "home", "about", "contact", "social", "branding"
  value     String   @db.LongText // JSON text, validated per key with Zod
  updatedAt DateTime @updatedAt
}

model ThemeSet {
  id        String  @id @default(cuid())
  leoYearId String  @unique
  leoYear   LeoYear @relation(fields: [leoYearId], references: [id], onDelete: Cascade)
  line1     String // “LEADING WITH PURPOSE”
  line2     String // EXECUTION WITH EXCELLENCE
  banner    String  @db.Text // JSON text: { curtainLeft, curtainRight, mountains, background }
  badges    String  @db.Text // JSON text: [{ src, alt }] up to 5
}

// ───────────── Contact ─────────────

enum MessageStatus {
  NEW
  REPLIED
  ARCHIVED
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String
  clubId    String?
  club      Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  body      String        @db.Text
  status    MessageStatus @default(NEW)
  consentAt DateTime
  ipHash    String?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}
