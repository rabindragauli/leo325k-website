# Copy to .env for local development. On the server, set these in cPanel → Setup Node.js App → Environment variables.
# NEVER commit real values.

NODE_ENV=production
APP_URL=https://leodistrict325knepal.org

# MySQL created in cPanel → MySQL Database Wizard (cPanel adds a prefix, e.g. cpuser_leo325k)
DATABASE_URL="mysql://cpuser_leo325k_app:CHANGE_ME@localhost:3306/cpuser_leo325k"

# Unlisted admin path, e.g. "manage-7f3k" → https://leodistrict325knepal.org/manage-7f3k
ADMIN_SLUG=manage-change-me

# 64+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me

# cPanel mailbox (Email Accounts) — use SSL port 465
SMTP_HOST=mail.leodistrict325knepal.org
SMTP_PORT=465
SMTP_USER=info@leodistrict325knepal.org
SMTP_PASS=change-me
MAIL_FROM="Leo District Council 325 K <info@leodistrict325knepal.org>"
CONTACT_INBOX=info@leodistrict325knepal.org

# Cloudflare Turnstile (free) — https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me

# Uploads live OUTSIDE the app folder so redeploys never delete them
UPLOAD_DIR=/home/cpuser/leo325k-uploads

# Protects /api/cron/daily
CRON_SECRET=change-me
